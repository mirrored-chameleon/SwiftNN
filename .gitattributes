# GitHub Linguist configuration

# Hide generated/build artifacts from language statistics
.build/** linguist-generated
.swiftpm/** linguist-vendored
DerivedData/** linguist-generated

# Xcode project metadata
*.xcodeproj/** linguist-vendored
*.xcworkspace/** linguist-vendored

# Treat Objective-C headers as Swift if they are part of Swift source tooling
*.h linguist-language=Swift

# Ignore generated Makefiles from language statistics
Makefile linguist-vendored
makefile linguist-vendored
GNUmakefile linguist-vendored

# Ignore other common generated/project files
Package.resolved linguist-vendored
